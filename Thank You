<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Thank You | The Dot Connector</title>

  <meta
    name="description"
    content="Thank you for contacting The Dot Connector. Your message has been received and a member of our team will be in touch."
  >

  <style>
    :root {
      --dark: #1a1a2e;
      --blue: #457B9D;
      --orange: #F4A261;
      --green: #2A9D8F;
      --purple: #8338EC;
      --red: #E63946;
      --white: #ffffff;
      --light: #f7f8fb;
      --text: #2c2c3a;
    }

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      font-family: Arial, Helvetica, sans-serif;
      background: var(--light);
      color: var(--text);
    }

    header {
      background: var(--white);
      border-bottom: 1px solid #eeeeee;
      padding: 20px 40px;
    }

    nav {
      max-width: 1100px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .brand {
      color: var(--dark);
      font-size: 1.15rem;
      font-weight: 700;
      text-decoration: none;
    }

    .home-link {
      color: var(--dark);
      font-weight: 600;
      text-decoration: none;
    }

    .home-link:hover {
      text-decoration: underline;
    }

    main {
      min-height: 65vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 80px 24px;
      position: relative;
      overflow: hidden;
    }

    .thank-you {
      width: min(680px, 100%);
      background: var(--white);
      padding: 60px 50px;
      border-radius: 18px;
      text-align: center;
      box-shadow: 0 18px 50px rgba(26, 26, 46, 0.10);
      position: relative;
      z-index: 2;
    }

    .dots {
      display: flex;
      justify-content: center;
      gap: 10px;
      margin-bottom: 25px;
    }

    .dot {
      width: 13px;
      height: 13px;
      border-radius: 50%;
    }

    .dot.one {
      background: var(--red);
    }

    .dot.two {
      background: var(--orange);
    }

    .dot.three {
      background: var(--green);
    }

    .dot.four {
      background: var(--blue);
    }

    .dot.five {
      background: var(--purple);
    }

    h1 {
      margin: 0 0 18px;
      color: var(--dark);
      font-size: clamp(2.5rem, 7vw, 4.5rem);
      line-height: 1;
    }

    .lead {
      margin: 0 auto 14px;
      max-width: 520px;
      font-size: 1.15rem;
      line-height: 1.7;
    }

    .subtext {
      margin: 0 auto 32px;
      max-width: 500px;
      line-height: 1.7;
      color: #666675;
    }

    .button {
      display: inline-block;
      background: var(--dark);
      color: var(--white);
      padding: 14px 26px;
      border-radius: 8px;
      text-decoration: none;
      font-weight: 700;
    }

    .button:hover {
      opacity: 0.9;
    }

    footer {
      background: var(--dark);
      color: white;
      padding: 28px 40px;
      text-align: center;
      font-size: 0.88rem;
    }

    .footer-content {
      max-width: 1100px;
      margin: 0 auto;
    }

    .footer-content p {
      margin: 6px 0;
      line-height: 1.6;
      color: white;
    }

    .footer-content a,
    .footer-content a:visited {
      color: white !important;
      text-decoration: none;
    }

    .footer-content a:hover {
      color: white !important;
      text-decoration: underline;
    }

    @media (max-width: 700px) {
      header {
        padding: 18px 20px;
      }

      main {
        padding: 50px 18px;
      }

      .thank-you {
        padding: 45px 25px;
      }

      footer {
        padding: 25px 20px;
      }
    }
  </style>
</head>

<body>

  <header>
    <nav>
      <a class="brand" href="/index.html">The Dot Connector</a>
      <a class="home-link" href="/index.html">Home</a>
    </nav>
  </header>

  <main>

    <section class="thank-you">

      <div class="dots" aria-hidden="true">
        <span class="dot one"></span>
        <span class="dot two"></span>
        <span class="dot three"></span>
        <span class="dot four"></span>
        <span class="dot five"></span>
      </div>

      <h1>Thank You.</h1>

      <p class="lead">
        Your message has been received.
      </p>

      <p class="subtext">
        Thank you for contacting The Dot Connector. A member of our team will review your message and be in touch soon.
      </p>

      <a class="button" href="/index.html">
        Return to The Dot Connector
      </a>

    </section>

  </main>

  <footer>
    <div class="footer-content">

      <p>
        <strong>The Dot Connector</strong> &copy; 2026. All rights reserved.
      </p>

      <p>
        601 Pennsylvania Avenue, NW, South Building, Suite 900<br>
        Washington, DC 20004
      </p>

      <p>
        Office:
        <a href="tel:+12024348934">(202) 434-8934</a>
        &nbsp;|&nbsp;
        Cell:
        <a href="tel:+16016068577">(601) 606-8577</a>
        &nbsp;|&nbsp;
        Email:
        <a href="mailto:buck@dotconnector.net">buck@dotconnector.net</a>
      </p>

    </div>
  </footer>

</body>
</html>
